VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO pfet
  CLASS BLOCK ;
  FOREIGN pfet ;
  ORIGIN 1.150 0.690 ;
  SIZE 6.890 BY 13.380 ;
  OBS
      LAYER Nwell ;
        RECT -1.150 -0.690 5.740 12.690 ;
      LAYER Metal1 ;
        RECT 0.140 12.300 0.520 12.680 ;
        RECT 0.940 12.300 1.320 12.680 ;
        RECT 1.740 12.300 2.120 12.680 ;
        RECT 2.540 12.300 2.920 12.680 ;
        RECT 3.340 12.300 3.720 12.680 ;
