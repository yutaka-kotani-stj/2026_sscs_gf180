        RECT -1.370 3.035 -0.990 14.635 ;
        RECT -0.570 3.035 -0.190 14.635 ;
        RECT 0.230 3.035 0.610 14.635 ;
        RECT 1.030 3.035 1.410 14.635 ;
        RECT -2.240 0.630 -2.040 3.020 ;
        RECT -2.240 0.430 1.280 0.630 ;
        RECT -2.240 -0.510 -2.040 0.430 ;
        RECT -0.520 -0.510 -0.320 0.430 ;
        RECT 1.080 -0.510 1.280 0.430 ;
