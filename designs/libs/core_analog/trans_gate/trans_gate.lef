        RECT 2.940 0.200 3.320 11.800 ;
        RECT 3.900 0.200 4.280 11.800 ;
        RECT 4.630 0.200 5.010 11.800 ;
  END
END pfet
MACRO nfet
  CLASS BLOCK ;
  FOREIGN nfet ;
  ORIGIN 0.420 0.670 ;
