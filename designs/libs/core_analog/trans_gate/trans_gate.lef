VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO trans_gate
  CLASS BLOCK ;
  FOREIGN trans_gate ;
  ORIGIN 3.060 6.500 ;
  SIZE 6.890 BY 23.000 ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Nwell ;
        RECT -3.060 2.145 3.830 15.525 ;
      LAYER Metal1 ;
        RECT 2.600 15.900 3.200 16.500 ;
        RECT 2.810 14.635 3.010 15.900 ;
        RECT 1.990 3.035 2.370 14.635 ;
        RECT 2.720 3.035 3.100 14.635 ;
    END
  END VDD
