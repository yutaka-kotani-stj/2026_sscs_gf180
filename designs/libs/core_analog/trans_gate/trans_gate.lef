        RECT 1.945 -5.900 2.145 -4.300 ;
        RECT 2.730 -5.900 2.930 -3.950 ;
        RECT 1.650 -6.500 2.250 -5.900 ;
        RECT 2.600 -6.500 3.200 -5.900 ;
    END
  END GND
  PIN ENB
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 16.799999 ;
    PORT
      LAYER Metal1 ;
        RECT -0.270 15.900 0.330 16.500 ;
        RECT -0.080 15.515 0.120 15.900 ;
        RECT -1.770 15.420 -1.390 15.515 ;
        RECT -0.970 15.420 -0.590 15.515 ;
        RECT -0.170 15.420 0.210 15.515 ;
        RECT 0.630 15.420 1.010 15.515 ;
        RECT 1.430 15.420 1.810 15.515 ;
        RECT -1.770 15.220 1.810 15.420 ;
        RECT -1.770 15.135 -1.390 15.220 ;
        RECT -0.970 15.135 -0.590 15.220 ;
        RECT -0.170 15.135 0.210 15.220 ;
        RECT 0.630 15.135 1.010 15.220 ;
        RECT 1.430 15.135 1.810 15.220 ;
    END
  END ENB
  PIN A
    DIRECTION INOUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 7.800000 ;
    PORT
      LAYER Metal1 ;
        RECT -2.420 15.900 -1.820 16.500 ;
        RECT -2.235 14.635 -2.035 15.900 ;
        RECT -2.330 3.035 -1.950 14.635 ;
    END
  END A
  PIN EN
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 5.600000 ;
    PORT
      LAYER Metal1 ;
        RECT -1.775 -4.595 -1.395 -4.520 ;
        RECT -0.975 -4.595 -0.595 -4.520 ;
        RECT -0.175 -4.595 0.205 -4.520 ;
        RECT 0.625 -4.595 1.005 -4.520 ;
        RECT 1.425 -4.595 1.805 -4.520 ;
        RECT -1.775 -4.795 1.805 -4.595 ;
        RECT -1.775 -4.900 -1.395 -4.795 ;
        RECT -0.975 -4.900 -0.595 -4.795 ;
        RECT -0.175 -4.900 0.205 -4.795 ;
        RECT 0.625 -4.900 1.005 -4.795 ;
        RECT 1.425 -4.900 1.805 -4.795 ;
        RECT -0.085 -5.900 0.115 -4.900 ;
        RECT -0.240 -6.500 0.360 -5.900 ;
    END
  END EN
  OBS
